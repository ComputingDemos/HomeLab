# Endpoints with embedded Splunk Universal Forwarder, Linux x86-64.
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
      iproute2 iputils-ping nmap tcpreplay curl ca-certificates procps \
      libatomic1 \
    && rm -rf /var/lib/apt/lists/*

ARG UF_VERSION=10.4.3
ARG UF_BUILD=4174a2deda5d
RUN curl --fail --location --silent --show-error \
      "https://download.splunk.com/products/universalforwarder/releases/${UF_VERSION}/linux/splunkforwarder-${UF_VERSION}-${UF_BUILD}-linux-amd64.tgz" \
      -o /tmp/splunkforwarder.tgz \
    && tar -xzf /tmp/splunkforwarder.tgz -C /opt \
    && rm /tmp/splunkforwarder.tgz

COPY uf-entrypoint.sh /usr/local/bin/uf-entrypoint.sh
RUN chmod 755 /usr/local/bin/uf-entrypoint.sh \
    && mkdir -p /var/log/lab /opt/splunkforwarder/etc/system/local
ENTRYPOINT ["/usr/local/bin/uf-entrypoint.sh"]
